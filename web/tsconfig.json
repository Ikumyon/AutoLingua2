{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "typeRoots": ["../../auto_lingua/node_modules/@types", "./node_modules/@types"],
    "paths": {
      "react": ["../../auto_lingua/node_modules/@types/react"],
      "react/*": ["../../auto_lingua/node_modules/@types/react/*"],
      "react-dom/*": ["../../auto_lingua/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
