/* System theme: default platform styles */

/* 保存スプリットボタン カラー定義 */
QToolButton#buttonSaveSplit {
    background-color: #0d6efd;
    color: #ffffff;
    border: 1px solid #0d6efd;
    font-weight: bold;
}

QToolButton#buttonSaveSplit:hover {
    background-color: #0b5ed7;
    border-color: #0a58ca;
}

QToolButton#buttonSaveSplit:pressed {
    background-color: #0a58ca;
    border-color: #0a53be;
}

QToolButton#buttonSaveSplit::menu-button {
    border-left: 1px solid rgba(255, 255, 255, 0.3);
}

QToolButton#buttonSaveSplit::menu-button:hover {
    background-color: rgba(0, 0, 0, 0.1);
}

/* スクラバー（RangeScrubberWidget）カラー定義 */
RangeScrubberWidget {
    qproperty-fillColor: #0d6efd;
    qproperty-hoverColor: rgba(255, 255, 255, 36);
    qproperty-bgColor: #2b2d30;
    qproperty-borderColor: #3c3f41;
    qproperty-textColor: #ffffff;
}

/* Source watch indicators: state is supplied by the UI/controller. */
QLabel#sourceWatchTitle {
    font-size: 12pt;
    font-weight: bold;
}

QLabel#labelSourceWatchIndicator,
QLabel#sourceWatchIndicator {
    border: none;
    border-radius: 7px;
    padding: 0;
}

QLabel#labelSourceWatchIndicator[watchState="running"],
QLabel#sourceWatchIndicator[watchState="running"] {
    background-color: #2eae61;
}

QLabel#labelSourceWatchIndicator[watchState="stopped"],
QLabel#sourceWatchIndicator[watchState="stopped"] {
    background-color: #db4b4b;
}

QLabel#labelSourceWatchIndicator[watchState="error"],
QLabel#sourceWatchIndicator[watchState="error"] {
    background-color: transparent;
    color: #db4b4b;
    font-weight: bold;
}
