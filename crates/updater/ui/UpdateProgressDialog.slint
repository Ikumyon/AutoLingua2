// Qt Designer: UpdateProgressDialog.ui -> Slint
// This file contains the UI only. Update operations are implemented by the Rust updater.
// page: 0 = download, 1 = ready, 2 = apply, 3 = error.

import { Button, ProgressIndicator, TextEdit } from "std-widgets.slint";

component PercentProgress inherits Rectangle {
    in property <int> percent: 0; // 0..100

    height: 24px;
    background: transparent;

    ProgressIndicator {
        width: parent.width;
        height: parent.height;
        progress: root.percent / 100.0;
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.percent + "%";
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component UpdateProgressDialog inherits Window {
    title: "AutoLingua Desktop の更新";
    preferred-width: 520px;
    preferred-height: root.log-expanded ? 520px : 320px;
    min-width: 460px;
    min-height: root.log-expanded ? 520px : 320px;

    // Equivalent to the currentIndex of Qt's stackProgress and stackActions.
    in-out property <int> page: 0;

    // Download page (page == 0)
    in-out property <string> download-status: "更新をダウンロードしています";
    in-out property <string> download-version: "— → —";
    in-out property <int> download-percent: 0;
    in-out property <string> download-bytes: "— / —";
    in-out property <string> download-speed-and-time: "—";

    // Ready page (page == 1)
    in-out property <string> ready-status: "更新の準備ができました";
    in-out property <string> ready-version: "— → —";

    // Apply page (page == 2)
    in-out property <string> apply-status: "更新を適用しています";
    in-out property <string> apply-version: "— → —";
    in-out property <int> apply-percent: 0;
    in-out property <string> apply-phase: "本体の終了を待っています";

    // Error page (page == 3)
    in-out property <string> error-status: "更新に失敗しました";
    in-out property <string> error-detail: "";

    // Collapsible process log
    in-out property <bool> log-expanded: false;
    in-out property <string> process-log: "";

    // Callbacks for the Rust updater to implement.
    callback cancel-download();
    callback later();
    callback apply-update();
    callback close-requested();
    callback retry();

    VerticalLayout {
        padding-left: 24px;
        padding-top: 24px;
        padding-right: 24px;
        padding-bottom: 20px;
        spacing: 10px;

        // Main content. Qt's QStackedWidget is mapped to conditional pages.
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            if root.page == 0 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 12px;

                Text {
                    text: root.download-status;
                    font-size: 16px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.download-version;
                    font-size: 14px;
                }
                PercentProgress {
                    percent: root.download-percent;
                }
                Text {
                    text: root.download-bytes;
                    font-size: 14px;
                }
                Text {
                    text: root.download-speed-and-time;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                }
            }

            if root.page == 1 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 12px;

                Text {
                    text: root.ready-status;
                    font-size: 16px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.ready-version;
                    font-size: 14px;
                }
                PercentProgress {
                    percent: 100;
                }
                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                }
            }

            if root.page == 2 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 12px;

                Text {
                    text: root.apply-status;
                    font-size: 16px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.apply-version;
                    font-size: 14px;
                }
                PercentProgress {
                    percent: root.apply-percent;
                }
                Text {
                    text: root.apply-phase;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                }
            }

            if root.page == 3 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 12px;

                Text {
                    text: root.error-status;
                    font-size: 16px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                TextEdit {
                    text: root.error-detail;
                    read-only: true;
                    vertical-stretch: 1;
                }
            }
        }

        // Qt's checkable QToolButton: buttonToggleLog.
        HorizontalLayout {
            height: 28px;
            spacing: 0px;

            Button {
                text: root.log-expanded ? "▼ 処理ログ" : "▶ 処理ログ";
                clicked => {
                    root.log-expanded = !root.log-expanded;
                }
            }
            Rectangle {
                background: transparent;
                horizontal-stretch: 1;
            }
        }

        // Qt's textProcessLog: initially hidden; read-only; no word wrap.
        if root.log-expanded : TextEdit {
            min-height: 180px;
            text: root.process-log;
            read-only: true;
            wrap: no-wrap;
            font-family: "monospace";
            font-size: 13px;
        }

        // Qt's stackActions: action set changes together with the progress page.
        if root.page == 0 : HorizontalLayout {
            height: 36px;
            Rectangle { background: transparent; horizontal-stretch: 1; }
            Button {
                text: "キャンセル";
                clicked => { root.cancel-download(); }
            }
        }

        if root.page == 1 : HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Rectangle { background: transparent; horizontal-stretch: 1; }
            Button {
                text: "あとで";
                clicked => { root.later(); }
            }
            Button {
                text: "本体を終了して更新";
                clicked => { root.apply-update(); }
            }
        }

        if root.page == 2 : Rectangle {
            height: 36px;
            background: transparent;
        }

        if root.page == 3 : HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Rectangle { background: transparent; horizontal-stretch: 1; }
            Button {
                text: "閉じる";
                clicked => { root.close-requested(); }
            }
            Button {
                text: "再試行";
                clicked => { root.retry(); }
            }
        }
    }
}
