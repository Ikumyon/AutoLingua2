import { Button } from "std-widgets.slint";
export component SplashWindow inherits Window {
    title: "AUTOlingua2";
    icon: @image-url("../../../assets/images/app.ico");
    in property <image> custom-image;
    in property <bool> has-custom-image: false;
    in-out property <length> window-width: 520px;
    in-out property <length> window-height: 300px;
    width: root.window-width;
    height: root.window-height;
    background: #181825;
    in property <string> status-text: "起動を準備しています…";
    in property <string> detail: "";
    in property <bool> failed: false;
    in property <bool> delayed: false;
    in property <bool> can-cancel: false;
    in property <float> progress: 0;
    callback cancel();
    callback dismiss();
    callback open-logs();

    if root.has-custom-image: Image {
        source: root.custom-image;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }

    if root.has-custom-image: Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, rgba(24, 24, 37, 0.45) 0%, rgba(24, 24, 37, 0.82) 55%, rgba(24, 24, 37, 0.95) 100%);
    }
    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        Text { text: "AUTOlingua2"; font-size: 28px; font-weight: 700; color: #cdd6f4; }
        Text { text: root.status-text; color: #cdd6f4; wrap: word-wrap; }
        Rectangle {
            height: 8px;
            background: #313244;
            border-radius: 4px;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * root.progress;
                height: parent.height;
                background: #89b4fa;
                border-radius: 4px;
            }
        }
        Text {
            text: root.delayed ? "起動に時間がかかっています。このまま待機できます。" : root.detail;
            color: #a6adc8;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 12px;
            if root.failed: Button { text: "ログを開く"; clicked => { root.open-logs(); } }
            if root.failed: Button { text: "閉じる"; clicked => { root.dismiss(); } }
            if root.delayed && root.can-cancel: Button { text: "起動を中止"; clicked => { root.cancel(); } }
        }
    }
}
