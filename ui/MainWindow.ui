           <widget class="QFrame" name="frameSegmentMode">
            <property name="styleSheet">
             <string notr="true">QFrame#frameSegmentMode {
    background-color: palette(alternate-base);
    border: 1px solid palette(mid);
    border-radius: 6px;
}
QFrame#frameSegmentMode QToolButton {
    background-color: transparent;
    color: palette(text);
    border: none;
    border-radius: 4px;
    padding: 3px 12px;
    font-weight: 500;
}
QFrame#frameSegmentMode QToolButton:hover:!checked {
    color: palette(highlight);
}
QFrame#frameSegmentMode QToolButton:checked {
    background-color: transparent;
    color: palette(highlighted-text);
    font-weight: bold;
}</string>
            </property>
